# --- Application ---
APP_NAME=Synclook
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# --- API ---
API_PREFIX=/api/v1
ALLOWED_ORIGINS=["http://localhost:3000"]

# --- Upload ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/synclook

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=3600

# --- DeepSeek LLM ---
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

# --- Vision ---
# BLIP captioning is optional display metadata; enabling it loads a ~1GB model.
VISION_ENABLE_CAPTION=false

# --- Rate Limiting ---
RATE_LIMIT=60/minute
