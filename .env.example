# --- Application ---
APP_NAME=Synclook
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# --- API ---
API_PREFIX=/api/v1
ALLOWED_ORIGINS=["http://localhost:3000"]

# --- Upload ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/synclook

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=3600

# --- DeepSeek LLM ---
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

# --- Langfuse observability (optional; tracing is disabled when empty) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Vision ---
# BLIP captioning is optional display metadata; enabling it loads a ~1GB model.
VISION_ENABLE_CAPTION=false
# Colour arm: "clip" (zero-shot softmax), "pixel" (CIELAB k-means alone), or
# "fused" (CLIP names the colour among those the pixels show). All local, no key.
VISION_COLOR_MODE=fused
# Type head: "coarse" (18-way, original) or "fine" (full 80-type taxonomy,
# mapped down for the style rules; also fills garment_type).
VISION_TYPE_MODE=fine
# Upload guard: refuse non-clothing / unusable photos with a friendly 422.
UPLOAD_GUARD_ENABLED=true

# --- Rate Limiting ---
RATE_LIMIT=60/minute

# --- Perception cascade (Phase 2) ---
# "clip" = local pipeline only, no keys needed.
# "cascade" = also describe the photo with the VLM (concurrently with CLIP) and
# judge it with Jev: better type, plus formality, aesthetic and occasions.
# Adds ~2s and ~$0.0002 per analysis. Missing keys degrade to "clip".
PERCEPTION_MODE=clip

# Jev (TypeSafe System One) — typed, calibrated classification.
# Key from console.typesafe.ai. Pin the model; aliases move and thresholds
# are version-specific.
JEV_API_KEY=your-jev-api-key-here
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_SECONDS=3.0
JEV_MAX_RETRIES=2

# Budget multimodal model — describes the garment, never classifies it.
# OpenAI-compatible; any gateway works by changing the base URL.
VLM_API_KEY=
VLM_BASE_URL=https://openrouter.ai/api/v1
VLM_MODEL=google/gemini-2.5-flash-lite
VLM_TIMEOUT_SECONDS=8.0

# --- Credits (Phase 7) — off for the demo; see README "Credits" ---
CREDITS_ENABLED=false
CREDITS_FREE_ANALYSES=3
# Requests sending `X-Demo-Key: <this>` are never charged. Give it to reviewers.
CREDITS_BYPASS_KEY=
# Unlocks POST /api/v1/credits/grant. Empty disables the endpoint.
CREDITS_ADMIN_KEY=
