# ─────────────────────────────────────────────────────────────
#  Docker environment — used by docker-compose
# ─────────────────────────────────────────────────────────────

# Application
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Database (matches docker-compose postgres service)
DATABASE_URL=postgresql+asyncpg://synclook:synclook_secret@postgres:5432/synclook

# Redis (matches docker-compose redis service)
REDIS_URL=redis://redis:6379/0
REDIS_TTL_SECONDS=7200

# DeepSeek LLM (optional — leave empty to disable)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Vision
VISION_DEVICE=cpu

# CORS — adjust for your frontend domain
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8081","http://localhost:19006"]

# Rate limiting
RATE_LIMIT=60/minute
